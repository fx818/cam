{
  "title": "CAM",
  "uid": "cam-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["cam"],
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP request rate (.req/s by status)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status) (rate(cam_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 duration by route",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(cam_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Invoke actions by status (per 5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (status) (increase(cam_audit_events_written_total{action=\"invoke\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Audit queue depth vs capacity",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [{ "expr": "cam_audit_queue_depth" }],
      "fieldConfig": {
        "defaults": {
          "max": 1000,
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 700 },
              { "color": "red", "value": 950 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Audit events dropped (total)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [
        { "expr": "increase(cam_audit_events_dropped_total[1h])", "legendFormat": "dropped" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Upstream MCP sessions active",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "expr": "cam_upstream_sessions_active", "legendFormat": "sessions" }]
    },
    {
      "type": "timeseries",
      "title": "DB pool in use / size",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "cam_db_pool_checked_out_connections", "legendFormat": "in use" },
        { "expr": "cam_db_pool_overflow_connections", "legendFormat": "overflow" },
        { "expr": "cam_db_pool_size", "legendFormat": "size" }
      ]
    },
    {
      "type": "table",
      "title": "Services by last health status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "cam_services_by_health", "instant": true, "legendFormat": "{{health}}",
          "format": "table" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Background job heartbeat (now - last run)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "time() - cam_scheduler_job_last_run_timestamp_seconds",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
