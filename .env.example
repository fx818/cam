# Copy to .env and fill in. Never commit .env.
CAM_ENV=dev
CAM_BASE_URL=http://localhost:8000
CAM_DATABASE_URL=postgresql+asyncpg://cam:cam@localhost:5432/cam

# Required when CAM_ENV=prod. Format: v1:<base64>,v2:<base64> — each key is 32 random bytes.
# Generate one with: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Back up the keys offline; losing them means stored credentials must be re-entered.
CAM_ENCRYPTION_KEYS=
CAM_ENCRYPTION_KEY_CURRENT=v1

# Required when CAM_ENV=prod. Signs dashboard sessions.
CAM_SESSION_SECRET=

CAM_DEFAULT_TIMEOUT_S=60
CAM_DEFAULT_RESPONSE_CAP_TOKENS=50000
CAM_LOG_RETENTION_DAYS=30
CAM_RATE_LIMIT_PER_MIN=120
CAM_HEALTHCHECK_INTERVAL_S=300
CAM_RESYNC_INTERVAL_S=3600
CAM_SESSION_IDLE_TIMEOUT_S=600
CAM_LOG_LEVEL=INFO
CAM_JOBS_ENABLED=true
CAM_DB_POOL_SIZE=10
CAM_DB_MAX_OVERFLOW=20

# Phase 8: uvicorn worker count in the container. MCP sessions live in
# process memory, so keep 1 worker and scale by replicas instead.
CAM_UVICORN_WORKERS=1
